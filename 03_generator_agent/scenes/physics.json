  "physics-optics-bench": {
    "subject": "物理",
    "components": [
      "experiment_stage",
      "parameter_controls",
      "result_cards",
      "comparison_panel",
      "records_table",
      "csv_export"
    ],
    "required": [
      "光具座",
      "光路",
      "读数"
    ],
    "visual_type": "apparatus",
    "solver_layer": "law",
    "law_contract": {
      "scene_id": "physics-optics-bench",
      "layer": "law",
      "contract_id": "physics.optics.refraction.v1",
      "equations": [
        "theta_i = theta_r",
        "n1*sin(theta1) = n2*sin(theta2)"
      ],
      "constraints": [
        "0 <= theta_i < 90",
        "n1 > 0",
        "n2 > 0",
        "sin(theta2) <= 1 or total_internal_reflection"
      ],
      "evidence": [
        "reflection_angle_deg",
        "refraction_angle_deg",
        "snell_residual",
        "total_internal_reflection"
      ],
      "tolerance": {
        "angle_deg": 1e-09,
        "residual": 1e-10
      },
      "oracle": "solve_optics",
      "reference_inputs": {}
    }
  },
